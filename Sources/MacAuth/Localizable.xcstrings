    "Das Dateiformat wird nicht erkannt. Unterstützt werden Aegis, 2FAS, Ente Auth (otpauth-Liste) und MacAuth-Sicherungen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dateiformat wird nicht erkannt. Unterstützt werden Aegis, 2FAS, Ente Auth (otpauth-Liste) und MacAuth-Sicherungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file format is not recognised. Supported are Aegis, 2FAS, Ente Auth (otpauth list) and MacAuth backups."
          }
        }
      }
    },
    "Das Konto „%@“ lässt sich nicht im Google-Format übertragen. Nutze stattdessen einen QR-Code je Konto.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
