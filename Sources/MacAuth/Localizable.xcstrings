    "Danach wirst du wie gewohnt zum Entsperren gefragt. Der Tresor, der sich nicht öffnen ließ, wird dabei zur Seite gelegt, nicht gelöscht.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach wirst du wie gewohnt zum Entsperren gefragt. Der Tresor, der sich nicht öffnen ließ, wird dabei zur Seite gelegt, nicht gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then you unlock as usual. The vault that would not open is set aside, not deleted."
          }
        }
      }
    },
