    "Bei mehreren QR-Codes scannst du einen nach dem anderen. Ein Bild kannst du auch auf das Fenster ziehen oder mit ⌘V einfügen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei mehreren QR-Codes scannst du einen nach dem anderen. Ein Bild kannst du auch auf das Fenster ziehen oder mit ⌘V einfügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If there are several QR codes, scan them one after another. You can also drag an image onto the window or paste it with ⌘V."
          }
        }
      }
    },
    "Beim Ruhezustand, bei gesperrtem Bildschirm und beim Benutzerwechsel sperrt MacAuth immer. Weniger Schutz einzustellen verlangt eine Abfrage mit Touch ID oder Passwort.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Ruhezustand, bei gesperrtem Bildschirm und beim Benutzerwechsel sperrt MacAuth immer. Weniger Schutz einzustellen verlangt eine Abfrage mit Touch ID oder Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAuth always locks on sleep, when the screen is locked and when switching users. Lowering protection asks for Touch ID or your password."
          }
        }
      }
    },
