    "Die %@-Datei ist verschlüsselt. Exportiere sie in %@ unverschlüsselt, importiere sie hier und lösche die Exportdatei danach.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %1$@-Datei ist verschlüsselt. Exportiere sie in %2$@ unverschlüsselt, importiere sie hier und lösche die Exportdatei danach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %1$@ file is encrypted. Export it unencrypted from %2$@, import it here, then delete the export file."
          }
        }
      }
    },
